# --- Theme ---
# This is my custom theme. copy it from ~/manual-sync-dotfiles/ghostty-zach-onehalf-dark to 
# /Applications/Ghostty.app/Contents/Resources/ghostty/themes/Zach One Half Dark
theme = Zach One Half Dark
keybind = cmd+shift+,=reload_config

# --- Get Tab Title From SSH ---
shell-integration = detect

# --- Font ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12

# --- Window Size ---
window-width = 160
window-height = 45
macos-titlebar-style = tabs

# --- Behavior ---
copy-on-select = clipboard
focus-follows-mouse = true
confirm-close-surface = false

# --- Navigation (HJKL to Arrows) ---
keybind = ctrl+k=text:\x1b[A
keybind = ctrl+j=text:\x1b[B
keybind = ctrl+h=text:\x1b[D
keybind = ctrl+l=text:\x1b[C

# --- Word Navigation using Native Actions ---
keybind = ctrl+alt+h=esc:b
keybind = ctrl+alt+l=esc:f

# --- Tabs (ctrl + shift) ---
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab
keybind = ctrl+shift+t=new_tab

# --- Splits (opt) ---
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:top
keybind = alt+j=goto_split:bottom
keybind = alt+minus=new_split:down
keybind = alt+backslash=new_split:right

# --- Tab Navigation ---
keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9
keybind = ctrl+shift+0=goto_tab:10
